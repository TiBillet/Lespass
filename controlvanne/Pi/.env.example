# Exemple documente du fichier .env du Pi.
# Le .env REEL est genere par `make claim` depuis config/env_example — ne pas copier
# ce fichier a la main. Il liste toutes les variables que le code lit et la valeur
# prise par chacune si elle est absente.
# / Documented example of the Pi .env. The REAL .env is generated by `make claim` from
# config/env_example — do not copy this file by hand. It lists every variable the code
# reads, and the value each one takes when absent.
# 
# --- Serveur (recus de POST /api/discovery/claim/) ---
# Adresse du TENANT (le lieu) — API + kiosk au quotidien
SERVER_URL=https://lespass.mondomaine.tld
# Adresse RACINE du serveur — uniquement pour (re)appairer (make claim)
CLAIM_SERVER_URL=https://mondomaine.tld
API_KEY=xxxxxxx.yyyyyyy
TIREUSE_UUID=abc123-def456-...
# False pour un serveur de dev en certificat auto-signe
# SSL_VERIFY=True
DEBUG=False

# --- Lecteur RFID ---
RFID_TYPE=RC522
# RFID_TYPE=VMA405
# RFID_TYPE=ACR122U
# Pour VMA405 uniquement :
# RFID_SERIAL_PORT=/dev/ttyUSB0
# RFID_BAUDRATE=9600
# Pour RC522 uniquement :
# RC522_SPI_DEVICE=0
# RC522_SPI_SPEED=1000000

# --- Vanne ---
GPIO_VANNE=18
# Decrit le CABLAGE, ne se devine pas : a MESURER sur chaque Pi (voir tireuses-FAQ.md).
# True = GPIO 1 ouvre la vanne (actif-haut). False = GPIO 0 ouvre (actif-bas).
# make claim remet cette valeur a True : re-verifier apres tout re-appairage.
VALVE_ACTIVE_HIGH=True

# --- Debitmetre ---
GPIO_FLOW_SENSOR=23
# Le serveur pousse son propre facteur au demarrage (ping) : cette valeur est un repli.
FLOW_CALIBRATION_FACTOR=6.5

# --- Reseau ---
NETWORK_TIMEOUT=5.0
MAX_RETRIES=3

# --- Systemd / logs ---
SYSTEMD_NOTIFY=True
# LOG_DIR=~/tibeer/logs

# --- Git (mise a jour auto au demarrage + defauts du Makefile) ---
GIT_REPO=https://github.com/TiBillet/Lespass.git
GIT_BRANCH=main-fedow-import